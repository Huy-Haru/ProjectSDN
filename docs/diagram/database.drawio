<mxfile host="app.diagrams.net"><diagram id="database" name="Database diagram — MongoDB"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="2320" dx="2200" dy="2320"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DATABASE DIAGRAM · MONGODB" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#172b43;strokeColor=#5479aa;fillColor=#eaf2fc;spacing=10;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="2130" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="Một entity xuất hiện một lần · Crow’s foot: || = 1; O| = 0..1; O&lt; = 0..N · Ref MongoDB không phải khóa ngoại" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#172b43;strokeColor=#5479aa;fillColor=#eaf2fc;spacing=10;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="80" width="2130" height="45" as="geometry"/></mxCell><mxCell id="user" value="User / users&#xa;_id: ObjectId [PK]&#xa;fullName, email [unique], password&#xa;phone, gender, dateOfBirth, avatar&#xa;role: member | trainer (PT) | admin&#xa;isActive: Boolean" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="470" height="280" as="geometry"/></mxCell><mxCell id="trainer" value="TrainerProfile / trainerprofiles&#xa;_id: ObjectId [PK]&#xa;user: ObjectId [ref User, unique]&#xa;specialties[], certificates[], bio&#xa;experienceYears, pricePerSession&#xa;ratingAverage, ratingCount, isActive" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="470" height="280" as="geometry"/></mxCell><mxCell id="pkg" value="MembershipPackage / membershippackages&#xa;_id: ObjectId [PK]&#xa;name, description, durationDays&#xa;price, sessionLimit (null = unlimited)&#xa;includesPT, isActive" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1610" y="170" width="470" height="280" as="geometry"/></mxCell><mxCell id="sub" value="Subscription / subscriptions&#xa;_id: ObjectId [PK]&#xa;member: ref User; package: ref Package&#xa;startDate, endDate, amount, paidAt&#xa;status: pending / active / expired / cancelled&#xa;paymentStatus: unpaid / paid&#xa;includesPT, sessionLimit; reservedSessions" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1610" y="770" width="470" height="280" as="geometry"/></mxCell><mxCell id="booking" value="Booking / bookings&#xa;_id: ObjectId [PK]&#xa;member: ref User; trainer: ref TrainerProfile&#xa;subscription: ref Subscription&#xa;date, startTime, endTime, note&#xa;quotaReserved: Boolean&#xa;status: booked / completed / cancelled / no_show" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="880" y="1060" width="470" height="280" as="geometry"/></mxCell><mxCell id="plan" value="WorkoutPlan / workoutplans&#xa;_id: ObjectId [PK]&#xa;member: ref User; trainer: ref TrainerProfile&#xa;title, goal, startDate, endDate, status&#xa;items[]: embedded exercises / sets / reps" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="100" y="1510" width="470" height="280" as="geometry"/></mxCell><mxCell id="progress" value="ProgressLog / progresslogs&#xa;_id: ObjectId [PK]&#xa;member: ref User; trainer?: ref TrainerProfile&#xa;date, weight, bodyFat, height&#xa;attendedSessions, note" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="880" y="1890" width="470" height="280" as="geometry"/></mxCell><mxCell id="review" value="Review / reviews&#xa;_id: ObjectId [PK]&#xa;member: ref User; trainer: ref TrainerProfile&#xa;booking: ref Booking [unique]&#xa;rating: integer 1–5; comment" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=17;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1610" y="1510" width="470" height="280" as="geometry"/></mxCell><mxCell id="notes" value="User là profile chung cho ba role; TrainerProfile chỉ mở rộng cho PT. ProgressLog.trainer tùy chọn.&#xa;Booking → Review là 1 → 0..1; User → TrainerProfile là 1 → 0..1. Các quan hệ còn lại có thể chưa có bản ghi con.&#xa;Tất cả collection có createdAt / updatedAt / __v. Index và validation chi tiết: docs/04-database-design.md và docs/06-mongodb-optimization.md." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#172b43;strokeColor=#5479aa;fillColor=#eaf2fc;spacing=10;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="2225" width="2050" height="90" as="geometry"/></mxCell><mxCell id="edge_0" value="Có hồ sơ PT" style="edgeStyle=none;orthogonal=1;rounded=0;html=0;strokeColor=#506b86;strokeWidth=1.6;jumpStyle=arc;jumpSize=9;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToOne;endFill=0;exitX=0;exitY=0.45;exitPerimeter=0;entryX=0.5;