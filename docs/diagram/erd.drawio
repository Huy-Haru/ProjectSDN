<mxfile host="app.diagrams.net"><diagram id="erd" name="ERD — FitManager"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="2320" dx="2200" dy="2320"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ENTITY RELATIONSHIP DIAGRAM · FITMANAGER" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=25;fontColor=#172b43;strokeColor=#5479aa;fillColor=#eaf2fc;spacing=10;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="2130" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="Một entity xuất hiện một lần · Crow’s foot: || = 1; O| = 0..1; O&lt; = 0..N · Ref MongoDB không phải khóa ngoại" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=16;fontColor=#172b43;strokeColor=#5479aa;fillColor=#eaf2fc;spacing=10;text;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="35" y="80" width="2130" height="45" as="geometry"/></mxCell><mxCell id="user" value="User&#xa;_id: ObjectId&#xa;Thông tin chung của Member / PT / Admin&#xa;email duy nhất; role kiểm soát quyền" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="470" height="225" as="geometry"/></mxCell><mxCell id="trainer" value="TrainerProfile&#xa;_id: ObjectId&#xa;Profile mở rộng riêng của PT&#xa;Mỗi User tối đa một TrainerProfile" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="470" height="225" as="geometry"/></mxCell><mxCell id="pkg" value="MembershipPackage&#xa;_id: ObjectId&#xa;Danh mục gói tập&#xa;Giá / thời hạn / quyền lợi" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1610" y="170" width="470" height="225" as="geometry"/></mxCell><mxCell id="sub" value="Subscription&#xa;_id: ObjectId&#xa;Một lần đăng ký gói của hội viên&#xa;Giá chốt, thời hạn, trạng thái thanh toán" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1610" y="770" width="470" height="225" as="geometry"/></mxCell><mxCell id="booking" value="Booking&#xa;_id: ObjectId&#xa;Một buổi hẹn PT của hội viên&#xa;Gắn một Subscription" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="880" y="1060" width="470" height="225" as="geometry"/></mxCell><mxCell id="plan" value="WorkoutPlan&#xa;_id: ObjectId&#xa;Giáo án cho một hội viên&#xa;items[] nhúng trong document" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="100" y="1510" width="470" height="225" as="geometry"/></mxCell><mxCell id="progress" value="ProgressLog&#xa;_id: ObjectId&#xa;Nhật ký chỉ số theo ngày&#xa;PT ghi nhận có thể để trống" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=19;fontColor=#172b43;strokeColor=#ac893f;fillColor=#fff5db;spacing=10;rounded=0;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="880" y="1890" width="470" height="225" as="geometry"/></mxCell><mxCell id="review" value="Review&#xa;_id: ObjectId&#xa;Đánh giá một buổi hoàn thành&#xa;Mỗi Booking tối đa một Review" style="html=0;whiteSpa